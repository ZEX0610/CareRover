# Copy to /etc/carerover/remote-hub.env on the server; never commit real values.
# Generate EACH token independently with: openssl rand -hex 32
AUDIO_DEVICE_TOKEN=REPLACE_WITH_64_HEX_CHARS_FOR_DEVICE
AUDIO_PARENT_TOKEN=REPLACE_WITH_DIFFERENT_64_HEX_CHARS_FOR_PARENT
# Choose one deployment mode:
# Public TLS: keep AUDIO_TLS_KEY/AUDIO_TLS_CERT and PORT=443 below.
# Private Tailscale Serve: comment out both TLS paths, set
# AUDIO_PROXY_PUBLIC_ORIGIN=https://YOUR-SERVER.YOUR-TAILNET.ts.net and PORT=8088.
# In the private mode the backend binds only to 127.0.0.1; do not publish port 8088.
AUDIO_TLS_KEY=/etc/carerover/tls/privkey.pem
AUDIO_TLS_CERT=/etc/carerover/tls/fullchain.pem
PORT=443
