[Unit]
Description=CareRover Remote Hub Prototype
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=carerover
Group=carerover
WorkingDirectory=/opt/carerover/remote-hub/relay
EnvironmentFile=/etc/carerover/remote-hub.env
ExecStart=/opt/node-v24.21.0-linux-x64/bin/node /opt/carerover/remote-hub/relay/server.mjs
Restart=on-failure
RestartSec=3
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
